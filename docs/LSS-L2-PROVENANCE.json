 "webPolicies": [
  {
   "id": "L2-W1",
   "tag": "W",
   "title": "Downloads",
   "rule": "Save Data (.TXT), Save spectrum (.SSP) are browser downloads: no folder, overwrite or IO-error boxes."
  },
  {
   "id": "L2-W2",
   "tag": "W",
   "title": "TXT encoding",
   "rule": "Windows-1252 bytes; a character outside it is written as ?; remarks cut to the native 36 characters."
  },
  {
   "id": "L2-W3",
   "tag": "W",
   "title": "Region destination",
   "rule": "Region rows go to their own table in #lss-survey; natively they go to the 144-byte Observation Results list (0x5b5bd4), which the LSS writer 0x57af74 never serialises, so their LSS .TXT is a web addition (V blank: natively unset); not saved."
  },
  {
   "id": "L2-W4",
   "tag": "W",
   "title": "Region numbers",
   "rule": "Bounds are binary64 (natively Extended); rows ordered by RA with catalogue order on ties (natively the time-then-RA sorted insert, one shared time)."
  },
  {
   "id": "L2-W6",
   "tag": "W",
   "title": "Measured Redshift Data",
   "rule": "RA/Dec read-only (native edits are discarded); Cancel adds nothing (natively the record is inserted before ShowModal); every OK is a new record; refused within 1e-12 of the 1 % limit; records listed in the v31 session wrapper."
  },
  {
   "id": "L2-W7",
   "tag": "W",
   "title": "Region masking",
   "rule": "Catalogue z is masked in the region table and the Search Results Z range; region rows are not handed to the wedge (coordinator decision of 2026-10-29)."
  },
  {
   "id": "L2-W8",
   "tag": "W",
   "title": "TXT row order",
   "rule": "Rows are written in the order they were recorded; natively in the list order sorted by (TDateTime, RA) (0x492728); they differ only if the site clock was moved backwards."
  },
  {
   "id": "L2-W9",
   "tag": "W",
   "title": "z = 0",
   "rule": "With z = 0 the web shows \"Velocity calculation is invalid!\"; natively the 0/0 or v/0 division raises an x87 EInvalidOp/EZeroDivide that reaches the VCL default box."
  },
  {
   "id": "L2-W5",
   "tag": "W",
   "title": "LSS spectrum header",
   "rule": "Object = the selected catalogue galaxy, pointing = the row HTL coordinates, magnitude = that galaxy catalogue magnitude; 4000–5000 Å interval as the LSS route."
  }
 ],
