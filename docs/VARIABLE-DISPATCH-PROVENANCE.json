 "webPolicies": [
  {
   "id": "VT-W1",
   "tag": "W",
   "title": "Frozen observatory-clock JD",
   "rule": "The web freezes the observatory-clock JD (siteClock/clockDrive) when a field is built (LSS list load, Field Information build), records it per LSS record and in the v30 wrapper (lssFieldJds); without it time-dependent values are typed variable-time-required."
  },
  {
   "id": "VT-W2",
   "tag": "W",
   "title": "Gate without a JD",
   "rule": "A TRUE star with unavailable values gates the field only when its 99×99 stamp reaches the 312² crop or a galaxy/QSO lies within the merge guard; otherwise it is not painted (pixel-identical)."
  },
  {
   "id": "VT-W3",
   "tag": "W",
   "title": "Numeric policy",
   "rule": "binary64 Number/Math for x87 Extended; Singles through Math.fround; Round half-even; Frac = x − trunc(x)."
  }
 ],
 "uncertainty": [
