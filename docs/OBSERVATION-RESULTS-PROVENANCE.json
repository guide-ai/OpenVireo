  "contracts": {
    "prepare": "When global option+0x2e8c=0,case-sensitive exact object-ID lookup scans first to last and returns first match;otherwise/new miss creates zero-initialized record before opening dialog. Classifier then copies RA/Dec Extended fields from spectrum+0x31/+0x3b.",
    "activate": "Loads fields from current record and calls spectral formatter;zero sentinel numerical fields show blank. It may calculate/store velocity on activation under a separate option and nonzero redshift,so this path is not a purely read-only native preview.",
    "confirm": "Copies readonly ID up to15,remarks up to36,converts entered spectral text to packedcode+0x5f,then optionally parses a nonempty velocity and checks relative error againstC*z. Native can modify textual fields before a later velocity rejection. No spectral grade or nonempty type/remarks requirement here.",
    "cancel": "bkCancel plus handler clears the unrelated owner flag+0x480. No record rollback/delete found in handler;web must not claim native provisional rows disappeared.",
    "type": "Case-sensitive generic table lookup;remove ASCIIspaces/colons;optional lower-case luminosity prefix;one-digit subclass plus optionalone decimaldigit,rounded*10;missing subclass99;ordered luminosity/suffix handling;packclass*1000000+sub*10000+lum*100+pec. Unrecognized initialclass returns0. Other trailing text may be ignored or supply one peculiarity.",
    "format": "Decompose integer code;prefix aliases,integer/one-decimal subclass,ordered suffixes,12byte final shortstring. Subclass99 omitted;zero omitted for prefix/early spectral groups. This is not lossless textual or code roundtrip for every label.",
    "velocityNotImplemented": {
      "C_exactFraction": "10548009391697539629/35184372088832",
      "relativeTolerance_exactFraction": "5902958103587056517/590295810358705651712",
      "reason": "No verified redshift/velocity/time/position/magnitudes in retained practice source. Nonempty velocity and unsafe zero/FPU paths not ported;no native FPU oracle."
    }
  },
  "implementedBoundary": [
    "Original25practiceidentities verified by existing catalog hashes and IO readiness;acquired/imported identities are not promoted. IDsource names all<=15bytes andunique. No catalog scientific measurement supplied.",
    "Temporary in-memory observation notebook only;no JSON/CSV/schema/nativefile output changes. Existing free40/1000answers,records andmanualwidth remain separate.",
    "Core generic type conversion/formatting and exact short remarks;source-bound first-object reuse,separate confirmations,selected-row editing. No answer key read or grade produced.",
    "Explicit printable Windows1252 and byte-cap admission;colon-only nil-string hazard rejected. Machine ACP,unsafe string reads and runtime/FPU equivalence not claimed.",
    "Web transaction stages row creation/writes until confirmation,keeps cancel atomic and rechecks source/ledger/mode/context;this differs from native early allocation/possible activation/partial velocity writes. Default reuse and100rowcap are authored browser choices exposing recovered branches.",
    "Readonly unavailable metadata remains explicit;velocity validation/autofill/photometry/nativefilepersistence/delete/undo remain outside this increment."
  ],
