{
  "name": "openvireo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-resources.mjs && vite --host 127.0.0.1",
    "build": "node scripts/check-resources.mjs && tsc -b && vite build && node scripts/check-i18n-dist.mjs && node scripts/check-deploy-limits.mjs",
    "test": "node scripts/check-resources.mjs && vitest run",
    "test:e2e": "node scripts/check-resources.mjs && playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "check:resources": "node scripts/check-resources.mjs",
    "test:resources": "node scripts/check-resources.test.mjs",
    "check:deploy-limits": "node scripts/check-deploy-limits.mjs",
    "test:deploy-limits": "node scripts/check-deploy-limits.test.mjs",
    "test:pages": "playwright test -c playwright.pages.config.ts",
    "test-fonts": "node scripts/test-fonts.mjs",
    "test:test-fonts": "node scripts/test-fonts.test.mjs",
    "test:scripts": "playwright test -c playwright.scripts.config.ts",
    "i18n:terms": "OPENVIREO_REFRESH_PINS=1 vitest run src/help/glossary.test.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "vite": "8.3.8",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-react": "6.3.0"
  }
}
