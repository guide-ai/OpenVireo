    {"id": "extended-just-below-tie", "v": {"kind": "dyadic", "coefficient": "9799832789158199295", "power": -62}, "b": {"kind": "decimal", "value": "3"}, "expect": {"status": "plotted", "x": 245, "y": 18}, "derivation": "V=2.125-2^-62 (coefficient 17*2^59-1, 64 significant bits). V-2 exact; *28=3.5-7*2^-60 exact in 64 bits -> Round 3. A binary64 port rounds V to 2.125 and draws y=19. B-V=0.875+2^-62; +0.5 exact; *120 rounds to 165+2^-55 -> 165."},
    {"id": "extended-product-rounds-onto-tie", "v": {"kind": "dyadic", "coefficient": "9563072123033578935", "power": -59}, "b": {"kind": "dyadic-plus-half-of-v", "note": "B=V+0.5 exactly"}, "expect": {"status": "plotted", "bMinusV": "0.5", "x": 200, "y": 423}, "derivation": "7*coefficient=929*2^56+1. V-2 exact (lsb2^-59,msb2^3). 28*(V-2)=408.5+2^-57; 64-bit significand in [256,512) has ulp2^-55 so the product rounds to 408.5, then FISTP nearest-even gives 408 (exact real rounding would give 409)."},
    {"id": "v-zero-skips-before-b-is-tested", "v": {"kind": "special", "value": "+0"}, "b": {"kind": "special", "value": "nan"}, "expect": {"status": "skipped-v-zero"}, "derivation": "je0x542af4 after V fcomp precedes the B load"},
