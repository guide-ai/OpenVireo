 "dropped": [
  {
   "en": "\\bcounts?\\b(?! shows after the reveal)",
   "why": "Count is a noun or verb meaning number, tally or counting (数量, 计数, 计, 次数) depending on the sentence; no single term fits every context."
  },
  {
   "en": "\\bfilters?\\b",
   "why": "Filter is an optical filter (滤光片) in the cameras but a list or table filter (筛选, 过滤) elsewhere; one Chinese term would be wrong in one of them."
  },
  {
   "en": "\\b(?:600-)?bins?\\b",
   "why": "Bin is a spectrum channel, histogram bin or sample slot (通道, 分箱, 区间) depending on the sentence; no single term fits every context."
  },
  {
   "en": "\\bfresh sky\\b",
   "why": "The French row has no stable single target: the English phrase is rendered in context as new readings, new measurements or a new sky; one Chinese term would force a wrong word."
  }
 ]
}
